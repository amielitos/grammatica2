# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# API Key for authenticating Flutter app requests (required)
API_SECRET_KEY=your_secret_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8001

# SMTP Email Configuration (required for /api/v1/email/send)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# PayMongo Configuration (required for /api/v1/payment/create-link)
PAYMONGO_SECRET_KEY=your_paymongo_secret_key
